<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/stagesynthesis/db" VERSION="20260903" COMMENT="XMLDB file for module mod_stagesynthesis"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="stagesynthesis" COMMENT="Instance de l'activité Suivi des stages (synthèse enseignant)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="stagesynthesis_link" COMMENT="Instance mod_stage (identifiée par son id de course-module) dont les étudiants doivent remonter dans une instance de Suivi des stages : permet d'exclure une promotion qui n'est plus suivie sans supprimer son activité stage d'origine">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="synthesisid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="stagecmid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"
            COMMENT="id du course-module de l'activité mod_stage liée"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="synthesisid" TYPE="foreign" FIELDS="synthesisid" REFTABLE="stagesynthesis" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="synthesisid_stagecmid" UNIQUE="true" FIELDS="synthesisid, stagecmid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
